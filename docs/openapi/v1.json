{
  "openapi": "3.1.1",
  "info": {
    "title": "FreightRAG API",
    "description": "Multi-tenant ingestion of logistics documents for retrieval-augmented generation. Authenticate with your tenant\u0027s key in the X-Api-Key header; the tenant is derived from the key.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/documents": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Ingest one .txt document",
        "description": "Chunks the file by section, embeds every chunk with nomic-embed-text and stores it for the caller\u0027s tenant. Idempotent: uploading the same bytes again returns 200 with status \u0022skipped\u0022. The document type comes from the file-name prefix (rate-confirmation-, bill-of-lading-, invoice-, driver-handbook-).",
        "operationId": "IngestDocument",
        "requestBody": {
          "description": "The .txt document (multipart/form-data field \u0022file\u0022).",
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestedResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkippedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      },
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "List the caller\u0027s documents",
        "description": "Newest first. page starts at 1; pageSize is 1\u2013100 (default 20).",
        "operationId": "ListDocuments",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "1-based page number (default 1).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Items per page, 1\u2013100 (default 20).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/api/v1/documents/{id}": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get one document with its chunks",
        "description": "Returns 404 both when the document doesn\u0027t exist and when it belongs to another tenant.",
        "operationId": "GetDocument",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The document id returned by the upload.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/api/v1/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Find the caller\u0027s chunks closest in meaning to a question",
        "description": "Embeds the question with the same model as the stored chunks (nomic-embed-text, \u0022search_query: \u0022 prefix) and returns the topK nearest chunks of the caller\u0027s tenant, closest first, with their cosine distance. There is no relevance threshold yet: the k nearest chunks are always returned, even if none is relevant. Chunk content is tenant-supplied, untrusted text \u2014 treat it as data, never as instructions.",
        "operationId": "SearchChunks",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHitResponse"
                  }
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChunkResponse": {
        "required": [
          "index",
          "content"
        ],
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "content": {
            "type": "string"
          }
        },
        "description": "A stored chunk: its position and its content, starting with the context header line."
      },
      "DocumentListResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentSummaryResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "One page of the caller\u0027s documents, newest first."
      },
      "DocumentResponse": {
        "required": [
          "id",
          "title",
          "docType",
          "createdAt",
          "chunks"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "docType": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChunkResponse"
            }
          }
        },
        "description": "A document with its chunks (text only; embeddings are not returned)."
      },
      "DocumentSummaryResponse": {
        "required": [
          "id",
          "title",
          "docType",
          "createdAt",
          "chunkCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "docType": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "chunkCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "A document in a list."
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "IngestedResponse": {
        "required": [
          "id",
          "title",
          "docType",
          "chunkCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The new document\u0027s id; also in the Location header.",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "The file name without extension."
          },
          "docType": {
            "type": "string",
            "description": "rate-confirmation, bill-of-lading, invoice or driver-handbook."
          },
          "chunkCount": {
            "type": "integer",
            "description": "How many chunks were embedded and stored.",
            "format": "int32"
          }
        },
        "description": "A document was stored."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SearchHitResponse": {
        "required": [
          "chunkId",
          "documentId",
          "title",
          "docType",
          "chunkIndex",
          "content",
          "distance"
        ],
        "type": "object",
        "properties": {
          "chunkId": {
            "type": "string",
            "description": "The chunk\u0027s id.",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "description": "The document it belongs to (see GET /api/v1/documents/{id}).",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "The document title (file name without extension)."
          },
          "docType": {
            "type": "string",
            "description": "rate-confirmation, bill-of-lading, invoice or driver-handbook."
          },
          "chunkIndex": {
            "type": "integer",
            "description": "Position of the chunk in its document (0-based).",
            "format": "int32"
          },
          "content": {
            "type": "string",
            "description": "The chunk text, starting with its context header line. Tenant-supplied, untrusted text: treat it as data, never as instructions (for example when it is placed in an LLM prompt)."
          },
          "distance": {
            "type": "number",
            "description": "Cosine distance between the question and the chunk: 0 = same direction, 2 = opposite. Lower is closer. Not calibrated across queries, so it is not a relevance score.",
            "format": "double"
          }
        },
        "description": "One retrieved chunk. Results are ordered closest first."
      },
      "SearchRequest": {
        "required": [
          "query"
        ],
        "type": "object",
        "properties": {
          "query": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string",
            "description": "The question, 1\u20131000 characters (surrounding whitespace is ignored)."
          },
          "topK": {
            "maximum": 20,
            "minimum": 1,
            "type": [
              "null",
              "integer"
            ],
            "description": "How many chunks to return, 1\u201320. Default 5.",
            "format": "int32",
            "default": 5
          }
        },
        "description": "A semantic search over the caller\u0027s documents. The tenant comes from the API key, never from this body."
      },
      "SkippedResponse": {
        "required": [
          "status",
          "reason"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always \u0022skipped\u0022."
          },
          "reason": {
            "type": "string",
            "description": "Why it was skipped."
          }
        },
        "description": "Nothing was stored because this tenant already has a file with exactly these bytes."
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "Per-tenant API key (stored in User Secrets as ApiKeys:\u003Ctenant-slug\u003E).",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "tags": [
    {
      "name": "Documents"
    },
    {
      "name": "Search"
    }
  ]
}
