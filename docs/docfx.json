{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["FreightRag.Core/FreightRag.Core.csproj", "FreightRag.Api/FreightRag.Api.csproj"]
        }
      ],
      "dest": "api",
      "properties": { "Configuration": "Release" }
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["_site/**"] }
    ],
    "resource": [
      { "files": ["openapi/**", "rest/**"] }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "FreightRAG",
      "_appTitle": "FreightRAG",
      "_appFooter": "FreightRAG — a learning project: multi-tenant RAG for logistics documents.",
      "_enableSearch": true
    }
  }
}
