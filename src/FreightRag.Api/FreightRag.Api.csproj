<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Same id as FreightRag.Ingest: one User Secrets file holds Database:Password and ApiKeys:*. -->
    <UserSecretsId>bc38a00e-bd57-4c78-9333-1f52ff1438ed</UserSecretsId>
    <!-- XML comments feed both the OpenAPI document and the DocFX API reference. CS1591/CS1573:
         not every member/parameter needs prose (injected services are left undocumented on purpose). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FreightRag.Core\FreightRag.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FreightRag.Tests" />
  </ItemGroup>
</Project>
