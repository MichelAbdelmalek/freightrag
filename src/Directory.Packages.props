<Project>
  <!--
    Central Package Management: every package version is pinned exactly, in one place.
    Rule for this repo: stable releases only, published at least 2 weeks before they are adopted.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- FreightRag.Core -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="[10.11.0]" />
    <PackageVersion Include="OllamaSharp" Version="[5.5.2]" />
    <PackageVersion Include="Npgsql" Version="[10.0.3]" />
    <PackageVersion Include="Pgvector" Version="[0.3.2]" />
    <!-- FreightRag.Ingest -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="[10.0.14]" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="[10.0.14]" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="[10.0.14]" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="[10.0.14]" />
    <!-- FreightRag.Tests (runs on Microsoft.Testing.Platform, see global.json; no VSTest packages needed) -->
    <PackageVersion Include="xunit.v3" Version="[4.0.2]" />
  </ItemGroup>
</Project>
