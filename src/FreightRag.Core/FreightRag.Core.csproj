<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- XML comments feed the DocFX API reference. Not every member needs prose, so CS1591 is off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <!--
    Core is layered DDD-style by folder/namespace:
      Domain          pure C#, no I/O, no third-party types
      Application     use cases + ports (interfaces); depends on Domain only
      Infrastructure  adapters (Postgres, Ollama) implementing the ports
    ArchitectureTests in FreightRag.Tests enforce that rule.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <!-- FreightRagSettings binds the Tenants section (Get<Dictionary<string, Guid>>). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FreightRag.Tests" />
    <InternalsVisibleTo Include="FreightRag.IntegrationTests" />
  </ItemGroup>
</Project>
