# Secrets must never enter the build context (and therefore never an image layer).
.env
.env.*
**/secrets.json

# Version control, IDE and OS noise
.git
.gitignore
.vs
.vscode
.idea
**/.DS_Store

# Build outputs (the container builds its own)
**/bin
**/obj
**/TestResults

# Not needed to build or test
evals
db
README.md
